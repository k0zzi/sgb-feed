# Copy and edit:  cp .env.example .env
# Values must not contain the "$" character (Docker Compose treats it as a variable).

# Port for the web UI and the feeds: https://SERVER_IP:1818
HTTPS_PORT=1818

# Web UI login. nginx refuses to start if UI_PASS is empty or still "change-me".
UI_USER=admin
UI_PASS=change-me

# Networks / IPs allowed to open the web UI (comma separated).
# These networks can also download the feed files.
UI_ALLOWED=10.0.0.0/8

# Firewall IPs allowed to download the feed files (comma separated).
# This is the address of the FIREWALL (the client), not of this server.
FEED_ALLOWED=10.0.0.1

# Records per API request. First full scan: ~503,000 / PAGE_SIZE requests.
PAGE_SIZE=1500

# Lines per full-list feed file.
PART_SIZE=128000

# Lite feed windows in days (comma separated): domain-46d.txt, ip-90d.txt, ...
FEED_WINDOWS=46,90,180,365

# Re-download the whole list every N days so records removed by the source
# disappear from the feeds (0 = disabled).
FULL_RESYNC_DAYS=7

# Update interval in minutes.
SYNC_INTERVAL_MINUTES=60

# The sync container turns "unhealthy" if the last successful sync is older
# than this many minutes.
HEALTH_MAX_AGE_MINUTES=150

# TLS certificate. On first start a CA (certs/ca.crt) and a server certificate
# signed by it are generated. The server certificate carries these names:
#   CERT_CN  DNS name the firewall uses to reach this server (or an IP address)
#   CERT_IP  comma-separated IP addresses of THIS SERVER, as written in the firewall's feed URL
# Set CERT_IP to the address you put into the firewall's feed URL, e.g. 192.0.2.10.
# It is not the firewall's address (that is FEED_ALLOWED).
# To use your own certificate instead, put server.crt and server.key into certs/.
CERT_CN=sgb-feed
CERT_IP=

TZ=Europe/Istanbul

# Corporate proxy, if required.
# HTTPS_PROXY=http://proxy.example.local:8080
# NO_PROXY=

# The UI warns when the last sync is older than this (hours); keep it in line with HEALTH_MAX_AGE_MINUTES.
# STALE_AFTER_HOURS=2.5
